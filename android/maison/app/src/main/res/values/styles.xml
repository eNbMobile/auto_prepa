<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="fond">#111827</color>
    <color name="accent">#38BDF8</color>

    <style name="Theme.Maison" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fond</item>
        <item name="android:statusBarColor">@color/fond</item>
        <item name="android:navigationBarColor">@color/fond</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="Theme.Maison.Config" parent="@android:style/Theme.Material">
        <item name="android:windowBackground">@color/fond</item>
        <item name="android:statusBarColor">@color/fond</item>
        <item name="android:navigationBarColor">@color/fond</item>
        <item name="android:colorPrimary">@color/fond</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- Télécommande flottante : fenêtre type feuille, fond assombri derrière. -->
    <style name="Theme.Maison.Flottante" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/fond_flottant</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="BoutonNotif">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bouton_notif</item>
        <item name="android:textAppearance">@android:style/TextAppearance.Material.Notification.Title</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
