<?xml version="1.0" encoding="utf-8"?>
<!-- Télécommande du volet : les identifiants t_* sont reliés aux touches dans NotifTele.java. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal">
    <ImageView android:id="@+id/t_volm" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:padding="12dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_t_moins" android:background="@drawable/bouton_notif" />
    <ImageView android:id="@+id/t_volp" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:padding="12dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_t_plus" android:background="@drawable/bouton_notif" />
    <ImageView android:id="@+id/t_mute" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:padding="12dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_t_son" android:background="@drawable/bouton_notif" />
    <ImageView android:id="@+id/t_play" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:padding="12dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_t_lecture" android:background="@drawable/bouton_notif" />
    <ImageView android:id="@+id/t_power" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_margin="3dp" android:padding="12dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_t_power" android:background="@drawable/bouton_notif_alim" />
</LinearLayout>
