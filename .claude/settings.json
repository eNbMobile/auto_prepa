{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && pip install -q -r \"$CLAUDE_PROJECT_DIR/requirements.txt\" >/dev/null 2>&1; exit 0",
            "timeout": 180
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tester_module.py\"",
            "timeout": 130
          }
        ]
      }
    ]
  }
}
